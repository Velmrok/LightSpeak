{
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "backend",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend": {
        "Destinations": {
          "d1": {
            "Address": "http://backend:8080/"
          }
        }
      }
    }
  }
}