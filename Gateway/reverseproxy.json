{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "keycloak",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      
      },
      "profile-route": {
        "ClusterId": "profile-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/profile/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/profile"
          }
        ]
      
      },
      "home-route": {
        "ClusterId": "compose-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/home"
        }
      }
    },
    "Clusters": {
      "keycloak": {
        "Destinations": {
          "d1": {
            "Address": "http://keycloak"
          }
        }
      },
      "profile-service": {
        "Destinations": {
          "d1": {
            "Address": "http://profile-service"
          }
        }
      },
      "compose-service": {
        "Destinations": {
          "d1": {
            "Address": "http://compose-service"
          }
        }
      }
    }
  }
}