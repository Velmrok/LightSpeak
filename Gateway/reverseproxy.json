{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "keycloak",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
        {
          "PathRemovePrefix": "/auth"
        }
      ]
      }
    },
    "Clusters": {
      "keycloak": {
        "Destinations": {
          "d1": {
            "Address": "http://keycloak"
          }
        }
      }
    }
  }
}