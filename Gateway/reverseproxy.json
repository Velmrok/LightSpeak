{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "keycloak",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      
      },
      "profile-route": {
        "ClusterId": "profile-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/profile/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/profile"
          }
        ]
      
      },
      "compose-route": {
        "ClusterId": "compose-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/compose/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/compose"
          }
        ]
      },
      "servers-route": {
        "ClusterId": "servers-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/servers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/servers"
          }
        ]
      },
      "home-route": {
        "ClusterId": "compose-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/home"
        }
      },
      "hub-route": {
        "ClusterId": "notifications-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notifications-service",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notifications"
          }
        ]
      }
    },
    "Clusters": {
      "keycloak": {
        "Destinations": {
          "d1": {
            "Address": "http://keycloak"
          }
        }
      },
      "profile-service": {
        "Destinations": {
          "d1": {
            "Address": "http://profile-service"
          }
        }
      },
      "compose-service": {
        "Destinations": {
          "d1": {
            "Address": "http://compose-service"
          }
        }
      },
      "servers-service": {
        "Destinations": {
          "d1": {
            "Address": "http://servers-service"
          }
        }
      },"notifications-service": {
        "Destinations": {
          "d1": {
            "Address": "http://notifications-service"
          }
        }
      }
    }
  }
}